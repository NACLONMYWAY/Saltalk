{
  "name": "nacl-english-listening",
  "version": "1.3.3",
  "description": "自用英语听力口语学习桌面应用",
  "main": "out/main/index.cjs",
  "type": "module",
  "author": "NACL",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-builder --win",
    "test": "node --test \"tests/unit/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/unit/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "msedge-tts": "^2.0.7"
  },
  "build": {
    "appId": "com.saltalk.app",
    "productName": "Saltalk",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "agent-base": "^9.0.0",
    "autoprefixer": "^10.5.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "http-proxy-agent": "^9.1.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  }
}
